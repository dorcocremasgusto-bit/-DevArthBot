# ── Frontend (Next.js on Vercel) ──────────────────────────────
# URL of your running DevArth-Bot pairing backend (see server/pairing-server.js).
# Without this, the pairing page will clearly report that the backend is offline.
BOT_BACKEND_URL=https://your-devarth-bot-host.example.com

# Optional shared secret. If set here AND on the backend, requests are authenticated.
BOT_API_KEY=

# ── Backend (server/pairing-server.js, persistent host) ───────
# Deploy the backend with one of the included configs:
#   - Docker:  docker build -t devarth-bot . && docker run -p 8080:8080 devarth-bot
#   - Render:  render.yaml (New > Blueprint)
#   - Railway: railway.json (Dockerfile builder)
#   - Fly.io:  fly.toml (fly launch --no-deploy && fly deploy)
# Then set BOT_BACKEND_URL above to the resulting host URL.
# PORT=8080
# BOT_API_KEY=change-me
# CORS_ORIGIN=https://your-vercel-app.vercel.app
